;;;; The ordered tree of exactly what was typed. Nothing is simplified, so x/x stays x/x.
;;;; Numbers are exact rationals, the variable is :x, and heads match rules/rules.sexp:
;;;; (+ a b) (- a b) (* a b) (/ a b) (neg a) (^ a n) (= left right).

(in-package :symalgebra.engine)

(define-condition refused (error)
  ((reason :initarg :reason :reader refused-reason))
  (:documentation "A line outside the fragment, with a reason code from docs/SEMANTICS.md."))

(defun refuse (reason)
  (error 'refused :reason reason))

(defconstant +max-tokens+ 64)
(defconstant +max-digits+ 8)
(defconstant +max-depth+ 16)
(defconstant +max-exponent+ 6)

(defun ascii-digit-p (c)
  (char<= #\0 c #\9))

(defun read-literal (word)
  (let ((dot (position #\. word)))
    (when (or (> (count #\. word) 1) (char= (char word (1- (length word))) #\.))
      (refuse "unparsed"))
    (when (> (count-if #'ascii-digit-p word) +max-digits+)
      (refuse "literal_too_long"))
    (if dot
        (let* ((whole (subseq word 0 dot))
               (part (subseq word (1+ dot)))
               (top (parse-integer (concatenate 'string whole part))))
          (/ top (expt 10 (length part))))
        (parse-integer word))))

(defun tokenize (text var)
  (let ((tokens '()) (i 0) (n (length text)))
    (loop while (< i n)
          do (let ((c (char text i)))
               (cond ((char= c #\Space) (incf i))
                     ((or (ascii-digit-p c) (char= c #\.))
                      (let ((j i))
                        (loop while (and (< j n)
                                         (or (ascii-digit-p (char text j)) (char= (char text j) #\.)))
                              do (incf j))
                        (push (read-literal (subseq text i j)) tokens)
                        (setf i j)))
                     ((char= c var) (push :var tokens) (incf i))
                     ((find c "+-*/=()^") (push c tokens) (incf i))
                     ((alpha-char-p c) (refuse "unknown_symbol"))
                     (t (refuse "unparsed")))))
    (when (> (length tokens) +max-tokens+)
      (refuse "too_many_tokens"))
    (coerce (nreverse tokens) 'vector)))

(defvar *tokens*)
(defvar *at*)

(defun kind (&optional (offset 0))
  (let ((i (+ *at* offset)))
    (when (< i (length *tokens*))
      (let ((token (aref *tokens* i)))
        (if (numberp token) :num token)))))

(defun take ()
  (prog1 (aref *tokens* *at*) (incf *at*)))

(defun parse-expression (depth)
  (when (> depth +max-depth+)
    (refuse "too_deep"))
  (let ((left (parse-term depth)))
    (loop while (member (kind) '(#\+ #\-))
          do (let ((op (if (char= (take) #\+) '+ '-)))
               (setf left (list op left (parse-term depth)))))
    left))

(defun parse-term (depth)
  (let ((left (parse-unary depth)))
    (loop
      (let ((k (kind)))
        (cond ((eql k #\*)
               (take)
               (setf left (list '* left (parse-unary depth))))
              ((eql k #\/)
               (take)
               (let ((right (parse-unary depth)))
                 ;; 1/2x could mean (1/2)x or 1/(2x), so it is a question, not a guess.
                 (when (member (kind) '(:var #\())
                   (refuse "ambiguous_division"))
                 (setf left (list '/ left right))))
              ((member k '(:var #\())
               (setf left (list '* left (parse-power depth))))
              (t (return left)))))))

(defun parse-unary (depth)
  (cond ((eql (kind) #\-)
         (take)
         (let ((inner (parse-unary depth)))
           (if (numberp inner) (- inner) (list 'neg inner))))
        (t (parse-power depth))))

(defun parse-power (depth)
  (let ((base (parse-atom depth)))
    (cond ((eql (kind) #\^)
           (take)
           (unless (eq (kind) :num)
             (refuse "unparsed"))
           (let ((exponent (take)))
             (unless (and (integerp exponent) (<= 1 exponent +max-exponent+))
               (refuse "exponent_range"))
             (list '^ base exponent)))
          (t base))))

(defun parse-atom (depth)
  (let ((k (kind)))
    (cond ((eq k :num) (take))
          ((eq k :var) (take) :x)
          ((eql k #\()
           (take)
           (let ((inner (parse-expression (1+ depth))))
             (unless (eql (kind) #\))
               (refuse "unparsed"))
             (take)
             inner))
          (t (refuse "unparsed")))))

(defun parse-line (text &optional (var #\x))
  "An (= left right) tree exactly as typed."
  (let* ((*tokens* (tokenize text var))
         (*at* 0)
         (left (parse-expression 0)))
    (unless (eql (kind) #\=)
      (refuse "unparsed"))
    (take)
    (let ((right (parse-expression 0)))
      (when (kind)
        (refuse (if (eql (kind) #\=) "chain" "unparsed")))
      (list '= left right))))

(defun tree-text (tree)
  "Fully bracketed text that parses back to TREE, for integer literals."
  (cond ((eq tree :x) "x")
        ((numberp tree) (if (minusp tree) (format nil "(~a)" tree) (format nil "~a" tree)))
        (t (destructuring-bind (head &rest args) tree
             (case head
               (= (format nil "~a = ~a" (tree-text (first args)) (tree-text (second args))))
               (neg (format nil "(-~a)" (tree-text (first args))))
               (^ (format nil "(~a^~a)" (tree-text (first args)) (second args)))
               (t (format nil "(~a ~a ~a)" (tree-text (first args)) head (tree-text (second args)))))))))
