;;;; Exponents and logarithms. Loaded by run.lisp, after complex.lisp.

(in-package :symalgebra.engine)

(defmacro log-says (name before after wanted)
  `(check ,name (string= (log-verdict-text (check-log-lines ,before ,after)) ,wanted)
          (log-verdict-text (check-log-lines ,before ,after))))

(defmacro value-says (name before after wanted)
  `(check ,name (string= (log-verdict-text (check-log-values ,before ,after)) ,wanted)
          (log-verdict-text (check-log-values ,before ,after))))

(defun constant-text (text)
  (with-fuel (lv-text (lconst (log-value-line text #\x)))))

(defmacro constant-is (name text wanted)
  `(check ,name (string= (constant-text ,text) ,wanted) (constant-text ,text)))

(defun log-status (line0 text)
  (getf (check-log-step line0 text) :status))

(defun log-solved (line0 text)
  (getf (check-log-step line0 text) :solved))

(tier "logs"
  ;; Reading.
  (check "log stays unknown outside these tasks" (eq (getf (check-lines "log2(x) = 1" "x = 1") :verdict) :out-of-fragment))
  (check "a base is read" (equal (log-value-line "log2(x)" #\x) '(log 2 :x)))
  (check "base ten is the default" (equal (log-value-line "log(x)" #\x) '(log 10 :x)))
  (check "ln is base e" (equal (log-value-line "ln(x)" #\x) '(log :e :x)))
  (check "e is read" (equal (log-value-line "e^x" #\x) '(exp :e :x)))
  (check "a power of x stays as it was" (equal (log-value-line "x^2" #\x) '(^ :x 2)))
  (check "a negative power is read" (equal (log-value-line "2^-3" #\x) '(exp 2 -3)))
  (check "a bracket is a power" (equal (log-value-line "2^(x + 1)" #\x) '(exp 2 (+ :x 1))))
  (check "a log multiplies" (equal (log-value-line "2log2(x)" #\x) '(* 2 (log 2 :x))))
  ;; Numbers.
  (constant-is "a whole log" "log2(8)" "3")
  (constant-is "a fraction log" "log4(8)" "3/2")
  (constant-is "a log of a fraction" "log2(1/8)" "-3")
  (constant-is "a fraction base" "log(1/2)(8)" "-3")
  (constant-is "base ten" "log(1000)" "3")
  (constant-is "ln e" "ln(e)" "1")
  (constant-is "ln of a power" "ln(e^3)" "3")
  (constant-is "a sum of logs" "log2(3) + log2(5) - log2(15)" "0")
  (constant-is "a log that stays" "log2(5)" "(ln(5))/(ln(2))")
  (constant-is "a natural log" "ln(5)" "ln(5)")
  (constant-is "a ratio of logs" "ln(5)/ln(2)" "(ln(5))/(ln(2))")
  (constant-is "a shifted log" "log2(5) - 1" "(-1 ln(2) + ln(5))/(ln(2))")
  (constant-is "a negative power" "2^(-3)" "1/8")
  (constant-is "a zero power" "5^0" "1")
  (constant-is "a root power" "8^(1/3)" "2")
  (constant-is "a fractional power" "4^(3/2)" "8")
  (constant-is "a power of e" "e^2" "e^2")
  (constant-is "a scaled power of e" "3e^2" "3 e^2")
  (constant-is "powers of e" "e^2 * e" "e^3")
  (constant-is "powers of e over" "(e^3)/e^3" "1")
  (constant-is "a root" "sqrt(9)" "3")
  (constant-is "a size" "|-3|" "3")
  (check "the same log in other words" (equal (with-fuel (lconst '(log 4 9))) (with-fuel (lconst '(log 2 3)))))
  ;; Numbers that are refused.
  (value-says "a log of zero" "log2(0)" "1" "OUT_OF_FRAGMENT log_domain")
  (value-says "a log of a negative" "log2(-1)" "1" "OUT_OF_FRAGMENT log_domain")
  (value-says "a base of one" "log1(5)" "1" "OUT_OF_FRAGMENT log_base")
  (value-says "a base of zero" "log0(5)" "1" "OUT_OF_FRAGMENT log_base")
  (value-says "two bases" "log2(5) + log3(5)" "1" "OUT_OF_FRAGMENT log_bases")
  (value-says "a product of logs" "log2(5)log2(3)" "1" "OUT_OF_FRAGMENT log_constant")
  (value-says "a root with no exact form" "2^(1/2)" "1" "OUT_OF_FRAGMENT log_constant")
  (value-says "zero to a negative" "0^(-1)" "1" "OUT_OF_FRAGMENT empty_domain")
  (value-says "a negative to a fraction" "(-8)^(1/3)" "1" "OUT_OF_FRAGMENT log_domain")
  (value-says "an enormous number" "log2(99999999 * 99999999)" "1" "OUT_OF_FRAGMENT limit")
  ;; Values.
  (value-says "the same number" "log2(8) + log2(4)" "5" "EQUIVALENT")
  (value-says "another number" "log2(8)" "4" "UNRELATED")
  (value-says "a log kept" "log2(3) + log2(5)" "log2(15)" "EQUIVALENT")
  (value-says "a law of powers" "x^2 * x^3" "x^5" "EQUIVALENT")
  (value-says "a power of a power" "(x^2)^3" "x^6" "EQUIVALENT")
  (value-says "a wrong power" "(x^2)^3" "x^5" "UNRELATED")
  (value-says "a quotient keeps its hole" "x^5/x^2" "x^3" "GAINS")
  (value-says "a negative power of x" "x^(-2) * x^5" "x^3" "GAINS")
  (value-says "a zero power of x" "x^0" "1" "GAINS")
  (value-says "a big power of x" "x^9" "1" "OUT_OF_FRAGMENT exponent_range")
  (value-says "a fraction power of x" "x^(1/2)" "1" "OUT_OF_FRAGMENT exponent_range")
  (value-says "a product inside a log" "log2(x) + log2(3)" "log2(3x)" "EQUIVALENT")
  (value-says "a quotient inside a log" "log2(x) - log2(5)" "log2(x/5)" "EQUIVALENT")
  (value-says "a number joins a log" "log2(x) + 3" "log2(8x)" "EQUIVALENT")
  (value-says "a wrong log law" "log2(x) + log2(3)" "log2(x + 3)" "UNRELATED")
  (value-says "two bases over x" "log2(x)" "log3(x)" "UNRELATED")
  (value-says "a power loses a side" "2log2(x)" "log2(x^2)" "UNRELATED")
  (value-says "a log beside x" "log2(x) + x" "x" "OUT_OF_FRAGMENT log_form")
  (value-says "an exponential over x" "2^x * 2" "2^(x + 1)" "OUT_OF_FRAGMENT log_form")
  (value-says "a log number beside x" "x + log2(5)" "x" "OUT_OF_FRAGMENT log_form")
  ;; Exponential lines.
  (log-says "a whole power" "2^x = 8" "x = 3" "EQUIVALENT")
  (log-says "the same base" "2^x = 8" "2^x = 2^3" "EQUIVALENT")
  (log-says "a shifted exponent" "3^(x - 1) = 27" "x - 1 = 3" "EQUIVALENT")
  (log-says "a new base" "4^x = 8" "2^(2x) = 2^3" "EQUIVALENT")
  (log-says "a fraction answer" "4^x = 8" "x = 3/2" "EQUIVALENT")
  (log-says "a falling base" "(1/2)^x = 4" "x = -2" "EQUIVALENT")
  (log-says "a scaled term" "5 * 3^x = 45" "3^x = 9" "EQUIVALENT")
  (log-says "a term moved over" "2^x + 1 = 9" "x = 3" "EQUIVALENT")
  (log-says "a wrong answer" "2^x = 8" "x = 4" "UNRELATED")
  (log-says "a log answer" "2^x = 5" "x = log2(5)" "EQUIVALENT")
  (log-says "a natural log answer" "e^x = 7" "x = ln(7)" "EQUIVALENT")
  (log-says "a ratio answer" "3^x = 7" "x = ln(7)/ln(3)" "EQUIVALENT")
  (log-says "a taken log" "3^x = 7" "x ln(3) = ln(7)" "EQUIVALENT")
  (log-says "another base for a log" "9^x = 25" "x = log3(5)" "EQUIVALENT")
  (log-says "a wrong log answer" "2^x = 5" "x = log2(7)" "UNRELATED")
  (log-says "a whole number against a log" "2^x = 5" "x = 2" "UNRELATED")
  (log-says "a shifted log answer" "2^(x + 1) = 5" "x = log2(5) - 1" "EQUIVALENT")
  (log-says "a negative slope" "2^(-x) = 5" "x = -log2(5)" "EQUIVALENT")
  (log-says "both sides powers" "2^x = 4^(x - 1)" "x = 2" "EQUIVALENT")
  (log-says "two bases" "2^x = 3^x" "x = 0" "OUT_OF_FRAGMENT log_bases")
  (log-says "two different terms" "2 * 2^x = 3 * 2^x" "x = 0" "OUT_OF_FRAGMENT log_form")
  (log-says "no power is negative" "2^x = -4" "1 = 2" "EQUIVALENT")
  (log-says "no power is zero" "2^x = 0" "1 = 2" "EQUIVALENT")
  (log-says "a power is above a negative" "2^x > -4" "0 = 0" "EQUIVALENT")
  (log-says "a power is not below a negative" "2^x <= -4" "1 = 2" "EQUIVALENT")
  (log-says "a term beside x" "2^x + x = 3" "x = 1" "OUT_OF_FRAGMENT log_form")
  (log-says "a base of one" "1^x = 1" "x = 0" "OUT_OF_FRAGMENT log_base")
  (log-says "a power over a square" "2^(x^2) = 16" "x = 2 or x = -2" "EQUIVALENT")
  (log-says "two exponents" "2^x + 2^x + 2^x = 8" "x = 1" "OUT_OF_FRAGMENT log_form")
  ;; Inequalities.
  (log-says "a rising base" "2^x > 8" "x > 3" "EQUIVALENT")
  (log-says "a falling base" "(1/2)^x > 4" "x < -2" "EQUIVALENT")
  (log-says "a negative coefficient" "-2^x < -8" "x > 3" "EQUIVALENT")
  (log-says "a wrong way round" "2^x > 8" "x < 3" "UNRELATED")
  (log-says "a wider line" "2^x > 8" "x > 2" "GAINS")
  (log-says "a log bound" "2^x > 5" "x > log2(5)" "EQUIVALENT")
  (log-says "a range" "1 < 2^x < 8" "0 < x < 3" "EQUIVALENT")
  (log-says "a negative slope turns a bound" "2^(-x) > 5" "x < -log2(5)" "EQUIVALENT")
  (log-says "pieces with a log bound" "2^x > 5 or x < 0" "x = 1" "OUT_OF_FRAGMENT log_form")
  ;; Logarithmic lines.
  (log-says "a log line" "log2(x) = 3" "x = 8" "EQUIVALENT")
  (log-says "the power form" "log2(x) = 3" "x = 2^3" "EQUIVALENT")
  (log-says "a shifted argument" "log3(x + 1) = 2" "x + 1 = 9" "EQUIVALENT")
  (log-says "base ten" "log(x) = 2" "x = 100" "EQUIVALENT")
  (log-says "base e" "ln(x) = 2" "x = e^2" "EQUIVALENT")
  (log-says "a scaled e" "ln(x) = 2" "x = 2e^2" "UNRELATED")
  (log-says "the sum of two logs" "log2(x) + log2(x - 2) = 3" "log2(x(x - 2)) = 3" "GAINS")
  (log-says "the false root stays out" "log2(x) + log2(x - 2) = 3" "x = 4" "EQUIVALENT")
  (log-says "the false root is added" "log2(x) + log2(x - 2) = 3" "x = 4 or x = -2" "GAINS")
  (log-says "a log on each side" "log2(x) = log2(5)" "x = 5" "EQUIVALENT")
  (log-says "the difference of two logs" "log2(x) - log2(3) = 1" "x = 6" "EQUIVALENT")
  (log-says "a falling log base" "log(1/2)(x) > 1" "0 < x < 1/2" "EQUIVALENT")
  (log-says "a log bound" "log2(x) < 3" "0 < x < 8" "EQUIVALENT")
  (log-says "the side a log must keep" "log2(x) < 3" "x < 8" "GAINS")
  (log-says "two bases" "log2(x) = log3(x)" "x = 1" "OUT_OF_FRAGMENT log_bases")
  (log-says "a fraction coefficient" "(1/2)log2(x) = 1" "x = 4" "OUT_OF_FRAGMENT log_form")
  (log-says "a log beside x" "log2(x) + x = 3" "x = 2" "OUT_OF_FRAGMENT log_form")
  (log-says "a constant with no exact power" "log2(x) = 1/3" "x = 1" "OUT_OF_FRAGMENT log_constant")
  (log-says "a bound in e" "ln(x) < 2" "x = 1" "OUT_OF_FRAGMENT log_constant")
  (log-says "a log with a log on the right" "log2(x) = log2(5) + 1" "x = 10" "EQUIVALENT")
  (log-says "a log and a surplus" "log2(x) + 1 = log2(3) + log2(5)" "x = 15/2" "EQUIVALENT")
  (log-says "plain lines still work" "x + 1 = 3" "x = 2" "EQUIVALENT")
  (log-says "pieces of plain lines" "x = 1 or x = 2" "(x - 1)(x - 2) = 0" "EQUIVALENT")
  ;; Using a verdict.
  (check "an equal line stands" (eq (log-status "2^x = 8" "2^x = 2^3") :accepted))
  (check "a wider line asks for care"
         (eq (log-status "log2(x) + log2(x - 2) = 3" "x(x - 2) = 8") :caution))
  (check "a wrong line is rejected" (eq (log-status "2^x = 8" "x = 2") :rejected))
  (check "a line out of reach is not checked" (eq (log-status "2^x = 8" "2^x + x = 8") :out-of-fragment))
  (check "a number finishes it" (log-solved "2^x = 8" "x = 3"))
  (check "the number may stand on the left" (log-solved "2^x = 8" "3 = x"))
  (check "the power form does not" (not (log-solved "2^x = 8" "2^x = 2^3")))
  (check "a sum of powers does not" (not (log-solved "log2(x) = 3" "x = 2^3")))
  (check "a log finishes it" (log-solved "2^x = 5" "x = log2(5)"))
  (check "a ratio of logs finishes it" (log-solved "3^x = 7" "x = ln(7)/ln(3)"))
  (check "a negative log finishes it" (log-solved "2^(-x) = 5" "x = -log2(5)"))
  (check "half a log finishes it" (log-solved "4^x = 5" "x = log2(5)/2"))
  (check "a power of e finishes it" (log-solved "ln(x) = 2" "x = e^2"))
  (check "a bound finishes it" (log-solved "2^x > 8" "x > 3"))
  (check "a range finishes it" (log-solved "log2(x) < 3" "0 < x < 8"))
  (check "x alone is not an answer" (not (log-solved "x = x" "x = x")))
  (check "no solution can be right" (getf (check-log-step "2^x = -4" "no solution") :solved))
  (check "no solution can be wrong" (eq (log-status "2^x = 4" "no solution") :rejected))
  (check "all numbers can be right" (getf (check-log-step "2^x > -1" "all real numbers") :solved))
  (check "a log claim with a log answer is wrong" (eq (log-status "2^x = 5" "no solution") :rejected))
  (flet ((value-step (text) (check-log-value-step "x^5/x^2" text '("x^3"))))
    (check "a value with a hole stands" (eq (getf (value-step "x^3") :status) :accepted))
    (check "a finished form finishes" (getf (value-step "x^3") :solved))
    (check "an unfinished form does not" (not (getf (value-step "x^2 * x") :solved)))
    (check "a wrong value is rejected" (eq (getf (value-step "x^2") :status) :rejected))
    (check "a value out of reach is not checked" (eq (getf (value-step "x^9") :status) :out-of-fragment)))
  ;; Words for a person.
  (check "a whole witness" (string= (witness-text 3) "3"))
  (check "a log witness" (string= (witness-text (with-fuel (lconst '(log :e 5)))) "ln(5)"))
  (check "a power witness" (string= (witness-text '(:epow 1 2)) "e^2"))
  ;; One number, one form.
  (value-says "a fraction base turns a log over" "log(1/2)(3)" "-log2(3)" "EQUIVALENT")
  (value-says "a fraction base and a fraction" "log(1/2)(1/3)" "log2(3)" "EQUIVALENT")
  (log-says "a solved line with a fraction base" "x = log(1/2)(3)" "x = -log2(3)" "EQUIVALENT")
  ;; Edges.
  (value-says "a division by a log of one" "log2(5)/log(1)" "1" "OUT_OF_FRAGMENT empty_domain")
  (log-says "x over a log of one" "x/log(1) = 1" "x = 1" "OUT_OF_FRAGMENT empty_domain")
  (value-says "a power past the limit" "2^100" "1" "OUT_OF_FRAGMENT limit")
  (log-says "x cancels beside a log number" "x + log2(5) = x" "x = 1" "OUT_OF_FRAGMENT log_form")
  (value-says "an exponential over x is not compared" "e^x * e^x" "e^(2x)" "OUT_OF_FRAGMENT log_form")
  (value-says "an exponential inside a log is not compared" "log2(2^x)" "x" "OUT_OF_FRAGMENT log_form")
  (value-says "two different exponentials are not compared" "2^x" "3^x" "OUT_OF_FRAGMENT log_form")
  (log-says "two powers, the larger taken away" "2^x - 4^x < 0" "x > 0" "EQUIVALENT")
  (log-says "two powers, the smaller taken away" "4^x - 2^x > 0" "x > 0" "EQUIVALENT")
  (log-says "two powers on the right" "0 > 2^x - 4^x" "x > 0" "EQUIVALENT"))
