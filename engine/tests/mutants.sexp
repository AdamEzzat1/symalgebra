;;;; Tier F mutants: (file old new). Each plants one fault, and the tests must fail. Each OLD must
;;;; occur in its file exactly once, so a mutant cannot quietly stop applying.

;;; Parsing
("parse" "(if (numberp inner) (- inner) (list 'neg inner))" "(if (numberp inner) inner (list 'neg inner))")
("parse" "(setf left (list op left (parse-term depth)))" "(setf left (list op (parse-term depth) left))")
("parse" "(when (> (length tokens) +max-tokens+)" "(when nil")
("parse" "(<= 1 exponent +max-exponent+)" "(<= 0 exponent +max-exponent+)")
("parse" "(when (multiplies-next-p (kind))
                   (refuse \"ambiguous_division\"))" "")
("parse" "(/ top (expt 10 (length part)))" "(/ top 10)")
("parse" "(refuse (if (relation-head (kind)) \"chain\" \"unparsed\"))" "(refuse \"unparsed\")")
("parse" "(when (> depth +max-depth+)" "(when nil")
("parse" "(when (> (count-if #'ascii-digit-p word) +max-digits+)" "(when nil")

;;; Polynomials and roots. The PNORMAL mutant is equivalent: it flips one sign convention everywhere,
;;; which no caller can see. It stays listed so the score is not flattered by dropping it.
("poly" "(when (> (+ (bits a) (bits b)) +max-bits+)" "(when nil")
("poly" "(num (abs (reduce #'gcd (mapcar #'numerator p))))" "(num (reduce #'gcd (mapcar #'numerator p)))")
("poly" "(if (and cleared (minusp (ksign (lead cleared))))" "(if (and cleared (plusp (ksign (lead cleared))))")
("poly" "collect (q* c i))))" "collect c)))")
("poly" "(pnormal (pquo p (pgcd p (pderivative p))))" "(pnormal p)")
("poly" "(rf (p+ (p* (car a) (cdr b)) (p* (car b) (cdr a))) (p* (cdr a) (cdr b)))"
        "(rf (p+ (car a) (car b)) (p* (cdr a) (cdr b)))")
("poly" "(rf (p* (car a) (cdr b)) (p* (cdr a) (car b)))" "(rf (p* (cdr a) (car b)) (p* (car a) (cdr b)))")
("poly" "(if (and (minusp direction) (oddp (degree p))) (- s) s)" "s")
("poly" "(let* ((k (1+ (floor (* low scale))))" "(let* ((k (floor (* low scale)))")
("poly" "(when (> (degree left) 2)
          (refuse \"irrational_root\"))" "")
("poly" "(sort found #'k<)" "found")

;;; Meaning and verdicts
("meaning" "(when (null (car bottom))
                      (refuse \"empty_domain\"))" "")
("meaning" "(setf *zeros* (plcm *zeros* (psquarefree (car bottom))))" "nil")
("meaning" "((> (degree top) +max-degree+) (refuse \"degree_limit\"))" "")
("meaning" "(cons :finite (pnormal (pquo square-free (pgcd square-free zeros))))" "(cons :finite square-free)")
("meaning" "((eq (car a) :finite) (cons :finite (pgcd p q)))" "((eq (car a) :finite) (cons :finite p))")
("meaning" "((eq (car b) :finite) (cons :allexcept (plcm p q)))" "((eq (car b) :finite) (cons :allexcept p))")
("meaning" "(t (cons :finite (pquo q (pgcd p q))))" "(t (cons :finite q))")
("meaning" "(loop for candidate from 0" "(loop for candidate from 1")
("meaning" "(no-loss (payload :gains gained))" "(no-loss (payload :loses gained))")
("meaning" "(t (payload :unrelated lost))" "(t (payload :unrelated gained))")
("meaning" "(unless no-gain (exact-roots (cdr gained)))" "")
("meaning" "(/ (unless (eql (second values) 0)
         (k/ (first values) (second values))))" "(/ (k/ (first values) (second values)))")

;;; Using a verdict
("step" ":solved (and (eq (getf from-start :verdict) :equivalent)
                                      (solved-form-p (parse-line text var)))"
        ":solved (solved-form-p (parse-line text var))")
("step" "(string= (getf from-previous :shape) \"Finite\")" "t")
("step" "(may-add-values-p (parse-line previous var))" "t")
("step" "(and (eq (car set) :finite) (empty-set-p set))" "(eq (car set) :allexcept)")
("step" "(and (answer-p left) (eq right :x))" "nil")

;;; Rule search
("search" "(total (unless (total-p bound) (setf state :failed)))" "(total nil)")
("search" "(nonzero-literal (when (eql (if (numberp bound) bound 0) 0) (setf state :failed)))" "(nonzero-literal nil)")
("search" "(literal (unless (numberp bound) (return :type)))" "(literal nil)")
("search" "((eql built (if (eq head '+) 0 1)) (node head rest))" "")
("search" "((and (eq (first built) '*) (eql (second built) 1) (null (cdddr built))) (third built))" "")
("search" "(as-fraction subject)))))" "nil))))")
("search" "(match pattern (list '* 1 subject) b))" "nil)")
("search" "append (list -1 (second item))" "collect item")
("search" "unless rest collect found))" "collect found))")
("search" "(when (equal start goal)
      (return-from search-rules (list :state :ok :rules nil :uses nil)))" "")

;;; The flat view
("rules" "(mapcar #'cdr (sort (mapcar (lambda (term) (cons (term-key term) term)) terms)
                      #'string< :key #'car))" "terms")
("rules" ":order (equal pattern replacement)" ":order nil")

;;; Quadratics
("parse" "(push (parse-relation) equations))" "(setf equations (list (parse-relation))))")
("meaning" "((eq (car a) :finite) (cons :allexcept (pquo q (pgcd p q))))" "((eq (car a) :finite) (cons :allexcept q))")
("meaning" "((eq (car b) :finite) (cons :allexcept (pquo p (pgcd p q))))" "((eq (car b) :finite) (cons :allexcept p))")
("meaning" "(t (cons :allexcept (pgcd p q))))))" "(t (cons :allexcept p)))))")
("meaning" "(some (lambda (item) (holds item x)) (rest line))" "(every (lambda (item) (holds item x)) (rest line))")
("step" "(every #'solved-form-p (rest line))" "t")
("search" "(= (* bound (first more)) (third more))" "t")
("search" "(square-of (unless (= (* bound bound) (first more)) (setf state :failed)))" "(square-of nil)")
("rules" "(remove-duplicates (mapcan (lambda (arg) (items-of 'or arg)) (rest tree))
                                         :test #'equal)" "(mapcan (lambda (arg) (items-of 'or arg)) (rest tree))")

;;; Practice replies
("tutor" "(if (holds before x)
            (format nil \"~a = ~a solves the line before." "(if (not (holds before x))
            (format nil \"~a = ~a solves the line before.")
("tutor" "(reply \"status\" \"accepted\" \"solved\" (solved-flag result)
              \"explanations\" (if (claim-p text)" "(reply \"status\" \"accepted\" \"solved\" :true
              \"explanations\" (if (claim-p text)")
("tutor" "(reply \"status\" \"caution\" \"solved\" :false
              \"explanations\" (explanations" "(reply \"status\" \"caution\" \"solved\" :true
              \"explanations\" (explanations")
("tutor" "(unless (and (stringp value) (<= (length value) 256)) (error 'bad-practice))" "")
("show" "(write-string (if found (show (cdr found) var) \"it\") out)" "(write-string \"it\" out)")

;;; Square roots
("poly" "(when (and d e (/= d e))
      (refuse \"many_radicals\"))" "")
("poly" "(surd (+ (r* a u) (r* (r* b v) d)) (+ (r* a v) (r* b u)) d)" "(surd (+ (r* a u) (r* b v)) (+ (r* a v) (r* b u)) d)")
("poly" "((> (r* a a) (r* (r* b b) (part-d x))) sa)" "((> (r* a a) (r* b b)) sa)")
("poly" "(q* x (q* (kconjugate y) (/ norm)))" "(q* x (q* y (/ norm)))")
("poly" "(when (oddp power) (setf d (* d p)))" "")
("poly" "(setf s (* s (expt p (floor power 2))))" "")
("poly" "(let ((b (/ s (denominator q))))" "(let ((b s))")
("poly" "(return (surd u (/ b (* 2 u)) d))" "(return (surd u b d))")
("poly" "(list (k+ half (k/ root 2)) (k+ half (k/ (kneg root) 2)))" "(list (k+ half (k/ root 2)))")
("poly" "(if (rational-p-p p) p (pgcd p (mapcar #'kconjugate p)))" "p")
("poly" "(and (part-d root) (part-d b) (/= (part-d root) (part-d b)))" "nil")
("meaning" "(when (has-variable-p inner)
    (refuse \"radical_variable\"))" "")
("meaning" "((consp n) (refuse \"nested_radical\"))" "")
("meaning" "((minusp n) (refuse \"negative_radicand\"))" "")
("meaning" "(when (rest (remove-duplicates (mapcan #'typed-radicands lines)))" "(when nil")
("meaning" "((zerop a) (format nil \"~a/~a\" core bottom))" "")
("parse" "((or (> signs 1) (find :or *tokens*)) (refuse \"unparsed\"))" "")
("parse" "(if (eq *plus-minus* '+) inner (negative inner))" "inner")
("parse" "(let ((*plus-minus* '-)) (parse-alternatives))" "(let ((*plus-minus* '+)) (parse-alternatives))")
("parse" "((eq k :sqrt) (take) (list 'sqrt (parse-atom depth)))" "((eq k :sqrt) (take) (parse-atom depth))")
("step" "(= (with-fuel (nth-value 1 (split-square (second tree)))) (second tree))" "t")
("step" "(and (eq (first tree) '/) (surd-literal-p (second tree)) (numberp (third tree)))" "nil")
("search" "(real-discriminant (when (minusp (- (* (first more) (first more)) (* 4 bound (second more))))
                                 (return :type)))" "(real-discriminant nil)")
("search" "(positive-literal (unless (and (numberp bound) (plusp bound)) (return :type)))" "(positive-literal nil)")
("search" "(half-square (unless (= (* (/ bound 2) (/ bound 2)) (first more)) (setf state :failed)))" "(half-square nil)")
("search" "(= (* bound bound k) p)" "t")
("search" "(= (+ (* bound (/ c q)) (* q (/ a bound))) b)" "t")
("search" "(every (lambda (m) (integerp (/ m bound))) more)" "t")
("search" "(if (find 'eval (remove-if-not #'consp (rest tree)) :key #'first) (tidy built) built)" "built")
("rules" "(reduce (lambda (a b) (if (> (abs b) (abs a)) b a))
                               (remove-if-not #'numberp (rest flat-term)))" "(find-if #'numberp (rest flat-term))")
("tutor" "(refused () (format nil \"~a = ~a solves one of these lines and not the other.\" var shown))" "(refused () \"\")")
("tutor" "(setf previous line)" "nil")
("tutor" ":test #'string= :from-end t)" ":test (constantly nil))")
("tutor" "(if (equal (flat (read-tree before var)) (flat (read-tree after var)))" "(if nil")
("tutor" "(or (jget problem \"nudge\")
                              \"Try the quadratic formula, and look at the number under the root.\")" "\"Try the quadratic formula, and look at the number under the root.\"")
("meaning" "(>= (not (minusp sign)))" "(>= (plusp sign))")
("meaning" "(<= (not (plusp sign)))" "(<= (minusp sign))")
("meaning" "(and inner (kabs inner))" "inner")
("meaning" "(append inner (mapcar (lambda (item) (list 'neg item)) inner))" "inner")
("meaning" "(k+ (first bounds) -1)" "(first bounds)")
("meaning" "(if next (midpoint bound next) (k+ bound 1))" "(k+ bound 1)")
("meaning" "(low (k+ low 1))" "(low low)")
("meaning" "(high (k+ high -1))" "(high high)")
("meaning" "((notany #'identity gained) (chart-payload :loses bounds lost))" "((notany #'identity gained) (chart-payload :unrelated bounds lost))")
("meaning" "always (or mark (oddp slot))" "always mark")
("meaning" "(when (> (abs-count line) +max-abs+)" "(when nil")
("search" "when (and (eq rule other) (same-parameters-p rule b other-b))" "when (eq rule other)")
("search" "(when (and (member (first subject) '(< <=)) (member head (list nil (first subject))))" "(when (member (first subject) '(< <=))")
("search" "((<= bound 0) (setf state :failed))" "((< bound 0) (setf state :failed))")
("search" "((>= bound 0) (setf state :failed))" "((> bound 0) (setf state :failed))")
("rules" "(> (list '< (flat (third tree)) (flat (second tree))))" "(> (list '< (flat (second tree)) (flat (third tree))))")
("step" "(if (member (first line) '(or and))" "(if (eq (first line) 'or)")
("step" "(if none (chart-empty-p line) (chart-cofinite-p line))" "(if none (chart-cofinite-p line) (chart-empty-p line))")

;;; Roots over the variable
("meaning" "(cond ((or (null inner) (minusp (ksign inner))) nil)" "(cond ((null inner) nil)")
("meaning" "(t (refuse \"irrational_root\")))))
        ((eq (first tree) 'sqrt)" "(t 0))))
        ((eq (first tree) 'sqrt)")
("meaning" "(variable-radical-p tree)
           (some #'chart-line-p (rest tree))" "(some #'chart-line-p (rest tree))")
("meaning" "((variable-radical-p tree) nil)
" "")
("meaning" "(if (or (holds-variable-radical-p left) (holds-variable-radical-p right))
      (radical-bounds left right)" "(if nil
      (radical-bounds left right)")
("meaning" "(= (zerop sign))" "(= (not (plusp sign)))")
("meaning" "(<= (not (plusp sign)))" "(<= (minusp sign))")
("meaning" "(>= (not (minusp sign)))" "(>= (plusp sign))")
("roots" "(when (= (length *radicals*) +max-radicals+)" "(when nil")
("roots" "(terms (terms+ (terms-of left) (terms-negated (terms-of right))))" "(terms (terms+ (terms-of left) (terms-of right)))")
("roots" "(reduce #'rf* (squared-roots (logand mask other))
                                               :initial-value (rf* value other-value))" "(rf* value other-value)")
("roots" "(if (oddp (logcount (logand mask signs))) (rf-negated value) value)" "value")
("roots" "(refuse \"nested_radical\"))" "nil)")
("roots" "(refuse \"radical_denominator\"))" "nil)")
("roots" "(edges (loop for inner in *radicals*
                      append (exact-roots (psquarefree (car (meaning-of inner))))))" "(edges nil)")
("roots" "(/ (not (eql (value (third tree) x) 0)))" "(/ t)")
("roots" "(sqrt (not (minusp (ksign (value (second tree) x)))))" "(sqrt t)")
("roots" "(and (defined-at-p left x)
         (defined-at-p right x)" "(and (defined-at-p left x)")
("roots" "(/ (1+ (isqrt (floor (* q (ash 1 (* 2 precision)))))) (ash 1 precision))" "(/ (isqrt (floor (* q (ash 1 (* 2 precision))))) (ash 1 precision))")
("roots" "(cons (+ (part-a x) (min near far)) (+ (part-a x) (max near far)))" "(cons (+ (part-a x) near) (+ (part-a x) far))")
("roots" "(ksign (k+ (value left x) (kneg (value right x))))" "0")
("roots" "(max 0 (car p) (- (cdr p)))" "(car p)")
("roots" "(cons (- (car p) (cdr q)) (- (cdr p) (car q)))" "(cons (- (car p) (car q)) (- (cdr p) (cdr q)))")
("step" "(or (variable-denominator-p line) (holds-variable-radical-p line))" "(variable-denominator-p line)")
("tutor" "'(\"sqrt\" \"abs\" \"log\" \"ln\")" "'()")
("tutor" "(or (jget step \"why\")
      (reason-words before after var)" "(or (reason-words before after var)")
("tutor" "((jget (aref steps index) \"why\"))
" "")

;;; Expression tasks
("parse" "(when (or (kind) (find :pm *tokens*))" "(when (kind)")
("parse" "(when (or (kind) (find :pm *tokens*))" "(when (find :pm *tokens*)")
