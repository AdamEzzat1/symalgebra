;;;; Complex numbers. Loaded by run.lisp, after systems.lisp.

(in-package :symalgebra.engine)

(defmacro complex-says (name before after wanted)
  `(check ,name (string= (complex-verdict-text (check-complex-lines ,before ,after)) ,wanted)
          (complex-verdict-text (check-complex-lines ,before ,after))))

(defmacro number-says (name before after wanted)
  `(check ,name (string= (complex-verdict-text (check-complex-numbers ,before ,after)) ,wanted)
          (complex-verdict-text (check-complex-numbers ,before ,after))))

(defun number-comes-to (text)
  (with-fuel (complex-text (number-of (number-line text)))))

(defmacro comes-to-is (name text wanted)
  `(check ,name (string= (number-comes-to ,text) ,wanted) (number-comes-to ,text)))

(defun complex-solved (line0 text &optional number-task)
  (getf (check-complex-step line0 text number-task) :solved))

(tier "complex"
  ;; Reading.
  (check "i stays unknown outside these tasks" (eq (getf (check-lines "x = i" "x = 1") :verdict) :out-of-fragment))
  (check "a number and i multiply" (equal (number-line "2i") '(* 2 :i)))
  (check "i and a root multiply" (equal (number-line "i sqrt(3)") '(* :i (sqrt 3))))
  ;; Working out.
  (comes-to-is "a sum" "(2 + 3i) + (1 - i)" "3 + 2i")
  (comes-to-is "a difference" "(2 + 3i) - (1 - i)" "1 + 4i")
  (comes-to-is "a negative" "-(2 + 3i)" "-2 - 3i")
  (comes-to-is "a product" "(2 + i)(3 - i)" "7 + i")
  (comes-to-is "a conjugate pair" "(1 + 2i)(1 - 2i)" "5")
  (comes-to-is "i squared" "i^2" "-1")
  (comes-to-is "i cubed" "i^3" "-i")
  (comes-to-is "i to the fourth" "i^4" "1")
  (comes-to-is "a quotient" "(1 + i)/(1 - i)" "i")
  (comes-to-is "a fraction in a quotient" "1/(2 + i)" "2/5 - 1/5i")
  (comes-to-is "dividing by i" "1/i" "-i")
  (comes-to-is "a negative root" "sqrt(-9)" "3i")
  (comes-to-is "a surd root" "sqrt(-3)" "sqrt(3)i")
  (comes-to-is "a positive root" "sqrt(4) + i" "2 + i")
  (comes-to-is "a size" "|3 + 4i|" "5")
  (comes-to-is "a real size" "|-2|" "2")
  (comes-to-is "just i" "i" "i")
  (comes-to-is "a mixed surd" "(1 + sqrt(5))i + 2" "2 + (1 + sqrt(5))i")
  (comes-to-is "a negative pure surd" "1 - sqrt(3)i" "1 - sqrt(3)i")
  (comes-to-is "zero" "i - i" "0")
  ;; Number verdicts.
  (number-says "the same number" "i^2" "-1" "EQUIVALENT")
  (number-says "another number" "i^2" "1" "UNRELATED Complex{} witness=1")
  (number-says "a line with x" "x + i" "1" "OUT_OF_FRAGMENT complex_degree")
  (number-says "a zero below" "1/(i - i)" "1" "OUT_OF_FRAGMENT empty_domain")
  (number-says "a size with a root" "|1 + i|" "sqrt(2)" "EQUIVALENT")
  (number-says "a size with no exact root" "|sqrt(2) + 1 + i|" "1" "OUT_OF_FRAGMENT complex_root")
  (number-says "a root of a non-real number" "sqrt(i)" "1" "OUT_OF_FRAGMENT complex_root")
  (number-says "a root over a surd" "sqrt(sqrt(2))" "1" "OUT_OF_FRAGMENT nested_radical")
  ;; Equation verdicts.
  (complex-says "the roots of a sum of squares" "x^2 + 4 = 0" "x = 2i or x = -2i" "EQUIVALENT")
  (complex-says "plus or minus" "x^2 + 4 = 0" "x = ±2i" "EQUIVALENT")
  (complex-says "a lost root" "x^2 + 4 = 0" "x = 2i" "LOSES Complex{-2i} witness=-2i")
  (complex-says "a gained root" "x = 2i" "x^2 + 4 = 0" "GAINS Complex{-2i} witness=-2i")
  (complex-says "a wrong root" "x^2 + 4 = 0" "x = 2" "UNRELATED Complex{-2i,2i} witness=-2i")
  (complex-says "the formula" "x^2 - 2x + 5 = 0" "x = (2 ± sqrt(-16))/2" "EQUIVALENT")
  (complex-says "a surd root" "x^2 + x + 1 = 0" "x = (-1 ± i sqrt(3))/2" "EQUIVALENT")
  (complex-says "a linear line with i" "2x + 3i = 1" "x = (1 - 3i)/2" "EQUIVALENT")
  (complex-says "a linear coefficient" "ix = 1" "x = -i" "EQUIVALENT")
  (complex-says "a cubic with a whole root" "x^3 - 1 = 0" "x = 1 or x^2 + x + 1 = 0" "EQUIVALENT")
  (complex-says "a fourth power" "x^4 - 1 = 0" "x = 1 or x = -1 or x = i or x = -i" "EQUIVALENT")
  (complex-says "a cubic with no whole root" "x^3 - 2 = 0" "x = 1" "OUT_OF_FRAGMENT complex_degree")
  (complex-says "a non-real discriminant" "x^2 + ix + 1 + i = 0" "x = 1" "OUT_OF_FRAGMENT complex_degree")
  (complex-says "a repeated root" "x^2 + 2ix - 1 = 0" "x = -i" "EQUIVALENT")
  (complex-says "every number" "x = x" "x + 1 = x + 1" "EQUIVALENT")
  (complex-says "every number lost" "x = x" "x = 0" "LOSES Complex{} witness=1")
  (complex-says "every number gained" "x = 1" "x = x" "GAINS Complex{} witness=0")
  (complex-says "no number" "x = x + 1" "1 = 2" "EQUIVALENT")
  (complex-says "every number among others" "x = 1 or x = x" "x = 2" "LOSES Complex{} witness=0")
  (complex-says "an inequality" "x < 1" "x = 1" "OUT_OF_FRAGMENT complex_relation")
  (complex-says "x below a line" "1/x = 1" "x = 1" "OUT_OF_FRAGMENT complex_degree")
  ;; Using a verdict.
  (check "a line that keeps the roots stands" (eq (getf (check-complex-step "x^2 + 4 = 0" "x^2 = -4" nil) :status) :accepted))
  (check "a line that loses one is rejected" (eq (getf (check-complex-step "x^2 + 4 = 0" "x = 2i" nil) :status) :rejected))
  (check "a line out of reach is not checked" (eq (getf (check-complex-step "x^2 + 4 = 0" "1/x = 2" nil) :status) :out-of-fragment))
  (check "the roots finish it" (complex-solved "x^2 + 4 = 0" "x = 2i or x = -2i"))
  (check "the number may stand on the left" (complex-solved "x^2 + 4 = 0" "2i = x or -2i = x"))
  (check "a line not yet answered does not" (not (complex-solved "x^2 + 4 = 0" "x^2 = -4")))
  (check "fractions finish it" (complex-solved "2x + 3i = 1" "x = (1 - 3i)/2"))
  (check "a root in the answer finishes it" (complex-solved "x^2 + 3 = 0" "x = ±i sqrt(3)"))
  (check "a + bi finishes a number" (complex-solved "i + i + 1" "1 + 2i" t))
  (check "bi + a does not" (not (complex-solved "i + i + 1" "2i + 1" t)))
  (check "two real terms do not" (not (complex-solved "1 + 1" "1 + 1" t)))
  (check "a product does not" (not (complex-solved "(2 + i)(3 - i)" "(3 - i)(2 + i)" t)))
  (check "a real number finishes" (complex-solved "i^2" "-1" t))
  (check "a pure imaginary finishes" (complex-solved "i + i" "2i" t))
  (check "a minus sign finishes" (complex-solved "1 - i - i" "1 - 2i" t))
  (check "a minus i finishes" (complex-solved "i^3" "-i" t))
  (check "i times a root finishes" (complex-solved "sqrt(-3)" "i sqrt(3)" t))
  (check "a root times i finishes" (complex-solved "sqrt(-3)" "sqrt(3) i" t))
  (check "a fraction finishes" (complex-solved "1/(2 + i)" "(2 - i)/5" t))
  (complex-says "a set is ordered by real part, then imaginary part" "(x - 2)(x^2 - 2x + 2) = 0" "x = 5"
                "UNRELATED Complex{1 - i,1 + i,2} witness=1 - i")
  (complex-says "a smaller real part comes first" "(x - 1)(x^2 - 4x + 5) = 0" "x = 5"
                "UNRELATED Complex{1,2 - i,2 + i} witness=1"))
